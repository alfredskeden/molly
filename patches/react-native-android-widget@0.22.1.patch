+import java.util.concurrent.atomic.AtomicInteger;
 
 public class RNWidget {
+    // Every clickable gets its own request code. PendingIntents differ only in extras, which don't count
+    // when matching, so two buttons drawn in the same millisecond shared a code and FLAG_CANCEL_CURRENT made
+    // the later one cancel the earlier: a dead button. Seeded from the clock once, so codes from an earlier
+    // process don't line up with this one's.
+    private static final AtomicInteger REQUEST_CODES = new AtomicInteger((int) System.currentTimeMillis());
+
     private final ReactApplicationContext appContext;
     private final ReadableMap config;
     private final String widgetName;
@@ -207,7 +214,7 @@ public class RNWidget {
