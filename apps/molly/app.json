      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
            "../../node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf",
            "../../node_modules/@expo-google-fonts/pixelify-sans/700Bold/PixelifySans_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/space-mono/700Bold/SpaceMono_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/chakra-petch/700Bold/ChakraPetch_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/ibm-plex-sans/700Bold/IBMPlexSans_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/bebas-neue/400Regular/BebasNeue_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/barlow/700Bold/Barlow_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/barlow/800ExtraBold/Barlow_800ExtraBold.ttf",
            "../../node_modules/@expo-google-fonts/vt323/400Regular/VT323_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/jetbrains-mono/700Bold/JetBrainsMono_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/jetbrains-mono/800ExtraBold/JetBrainsMono_800ExtraBold.ttf",
            "../../node_modules/@expo-google-fonts/sniglet/800ExtraBold/Sniglet_800ExtraBold.ttf",
            "../../node_modules/@expo-google-fonts/quicksand/700Bold/Quicksand_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/dm-serif-display/400Regular/DMSerifDisplay_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/mulish/700Bold/Mulish_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/mulish/800ExtraBold/Mulish_800ExtraBold.ttf",
            "../../node_modules/@expo-google-fonts/mulish/900Black/Mulish_900Black.ttf",
            "../../node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Molly",
              "label": "Molly",
              "description": "Sleep, feeding and diapers at a glance",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Sleep",
              "label": "Sleep",
              "description": "Start and stop sleep",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Feeding",
              "label": "Feeding",
              "description": "Start and stop feeds",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Diaper",
              "label": "Diaper",
              "description": "Log diaper changes",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-release-signing",
      [
        "expo-camera",
        {
          "cameraPermission": "Molly uses the camera to scan the login QR code from Baby Buddy.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Molly attaches the photo you pick to a to-do item.",
          "cameraPermission": "Molly uses the camera to scan the login QR code from Baby Buddy and to take photos for to-do items.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
